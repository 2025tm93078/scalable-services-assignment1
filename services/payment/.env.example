PORT=3003
# Own database + own credentials (database-per-service). Adjust host/port to your Postgres.
DATABASE_URL=postgres://payment_user:payment_pass@localhost:5432/payment_db
# URL of the mock payment provider
GATEWAY_URL=http://localhost:3005
# How long Payment waits for the gateway before giving up (ms)
GATEWAY_TIMEOUT_MS=4000
# How long a duplicate request waits for the first one to finish before returning 409 (ms)
IDEMPOTENCY_WAIT_MS=5000
LOG_LEVEL=info
